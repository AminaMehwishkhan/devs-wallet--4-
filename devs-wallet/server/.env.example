PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devs_wallet
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: force SSL for hosted Postgres providers that db.js doesn't auto-detect
# (auto-detection already enables SSL for any non-localhost DATABASE_URL)
# DB_SSL=true
